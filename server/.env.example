# Bearer token shared by all fileSync nodes. Must be identical across the fleet.
# Generate with: openssl rand -hex 32
FILESYNC_SHARED_SECRET=replace-me-with-a-long-random-string

# Optional overrides
# FILESYNC_CONFIG_DIR=./config
# FILESYNC_DATA_DIR=./data
# FILESYNC_CERTS_DIR=./certs
# FILESYNC_UI_PORT=3001
# FILESYNC_DISABLE_UI=1
